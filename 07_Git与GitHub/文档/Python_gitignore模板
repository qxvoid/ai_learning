# ============================================================
# Python / Jupyter / 数据分析项目 .gitignore 模板
# 用法：把本文件全部内容复制到你项目根目录，命名为 .gitignore
#       （文件名开头有个点，没有后缀；Windows 下在 PowerShell 里
#         用 New-Item 或 VSCode 另存为 .gitignore 即可）
# 来源：消化自 https://github.com/github/gitignore 的 Python 模板 +
#       数据科学项目实际需要，2026-10-09 整理。
# ============================================================


# ---------- Python 字节码与缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/
.python-version

# ---------- 打包 / 发布 ----------
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ---------- 测试 / 覆盖率 ----------
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.cache/
.noseid

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/
*.-checkpoint.ipynb

# ---------- 数据分析中间产物 ----------
# 大体积数据文件默认不进 Git。
# 如果你的 CSV 很小（< 5MB）且是项目必需，可以把对应行注释掉再 add。
*.csv
*.tsv
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.npy
*.npz

# 数据集目录与压缩包（MovieLens 这类数据别传）
data/
*.zip
*.tar.gz
*.rar
*.7z

# 注意：本仓库若故意要附小数据示例，用 ! 取反放行，例如：
# !data/sample_small.csv

# ---------- 密钥与本地配置（绝不能上传） ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
config.local.*
credentials.*

# ---------- R / 其他偶发 ----------
.Rhistory
.RData
.Rproj.user/

# ---------- 操作系统垃圾 ----------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------- 编辑器 / IDE ----------
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- 日志 ----------
*.log
logs/

# ============================================================
# 排错提示：
#  - 想知道某文件为啥被忽略：git check-ignore -v 文件名
#  - 已经被跟踪的文件写进这里不生效：git rm --cached 文件名
# ============================================================
